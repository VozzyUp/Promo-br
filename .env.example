# Copie para .env.local e preencha. Nunca commite valores reais.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Endereço público do site (links dos e-mails de confirmação e senha)
NEXT_PUBLIC_SITE_URL=

# AdSense (opcional): ID do editor e do bloco de anúncio. Vazios = sem anúncios.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# Chave que criptografa as credenciais das integrações (Painel > Integrações). Gere com: openssl rand -hex 32. Guarde uma cópia.
MASTER_KEY=

# Liga o agendador interno (robô, envio, reconferência). Use 1 e uma réplica só.
WORKER_ENABLED=
# 1 liga o botão "Continuar com Google" (antes, ative o provedor Google no Supabase: Authentication > Sign In / Providers)
GOOGLE_LOGIN=

# Sal do hash diário de visitante (cliques, LGPD). Gere com: openssl rand -hex 32
HASH_SALT=

# Só modo sem Supabase (desenvolvimento em memória)
SESSION_SECRET=
DEV_ADMIN_PASSWORD=

# Seed (scripts/seed.mjs): senha do admin de teste no Supabase
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
