# Copie para .env.local e preencha. Nunca commite valores reais.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Endereço público do site (links dos e-mails de confirmação e senha)
NEXT_PUBLIC_SITE_URL=

# Sal do hash diário de visitante (cliques, LGPD). Gere com: openssl rand -hex 32
HASH_SALT=

# Só modo sem Supabase (desenvolvimento em memória)
SESSION_SECRET=
DEV_ADMIN_PASSWORD=

# Seed (scripts/seed.mjs): senha do admin de teste no Supabase
SEED_ADMIN_PASSWORD=
